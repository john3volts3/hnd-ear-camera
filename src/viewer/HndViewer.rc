#include <winver.h>
#include "../common/HndCam.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION HNDCAM_VERSION_MAJOR,HNDCAM_VERSION_MINOR,HNDCAM_VERSION_PATCH,0
 PRODUCTVERSION HNDCAM_VERSION_MAJOR,HNDCAM_VERSION_MINOR,HNDCAM_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "hnd-ear-camera project"
            VALUE "FileDescription", "HND Ear Camera browser viewer"
            VALUE "FileVersion", HNDCAM_VERSION_STR
            VALUE "InternalName", "HndViewer"
            VALUE "OriginalFilename", "HndViewer.exe"
            VALUE "ProductName", "HND Ear Camera"
            VALUE "ProductVersion", HNDCAM_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
